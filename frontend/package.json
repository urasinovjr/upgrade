{
  "name": "upgrade-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:server": "vite --host 127.0.0.1 --mode server",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc --noEmit && vite build --mode server",
    "build:standalone": "tsc --noEmit && node scripts/build-standalone.mjs",
    "build:references": "node scripts/build-reference-board.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:server": "playwright test -c playwright.server.config.ts",
    "e2e:docker": "E2E_BASE_URL=http://127.0.0.1:8080 playwright test -c playwright.server.config.ts",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "e2e:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots=changed",
    "e2e:visual:docker": "node scripts/visual-docker.mjs",
    "e2e:visual:docker:update": "node scripts/visual-docker.mjs --update-snapshots=changed"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.104.0",
    "html-to-image": "1.11.13",
    "idb": "8.0.3",
    "lucide-react": "1.49.0",
    "mathlive": "0.110.0",
    "pdfmake": "0.3.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "11.0.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
