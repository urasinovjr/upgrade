{
  "log": { "loglevel": "none" },
  "inbounds": [
    {
      "tag": "openrouter-connect",
      "listen": "0.0.0.0",
      "port": 18080,
      "protocol": "http",
      "settings": {}
    }
  ],
  "outbounds": [
    {
      "tag": "openrouter",
      "protocol": "vless",
      "settings": {
        "address": "proxy.example",
        "port": 443,
        "id": "00000000-0000-0000-0000-000000000001",
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "serverName": "example.com",
          "fingerprint": "firefox",
          "password": "REPLACE_WITH_REALITY_PASSWORD",
          "shortId": "0123456789abcdef",
          "spiderX": "/"
        }
      }
    },
    { "tag": "blocked", "protocol": "blackhole", "settings": {} }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "domain": ["full:openrouter.ai"],
        "port": "443",
        "outboundTag": "openrouter"
      },
      { "type": "field", "network": "tcp,udp", "outboundTag": "blocked" }
    ]
  }
}
